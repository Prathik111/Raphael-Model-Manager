{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raphael Model Manager",
  "version": "0.1.0",
  "identifier": "com.raphael.modelmanager",
  "build": {
    "beforeDevCommand": "npm run prepare:reference && npm run dev:supervised",
    "beforeBuildCommand": "npm run prepare:reference && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Raphael Model Manager",
        "width": 1500,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "ComfyUI and Civitai model manager",
    "longDescription": "Local-first ComfyUI model manager with Civitai installation, metadata, prompts and offline gallery caching.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../dist": "web"
    }
  }
}
